# Secrets — never commit
.env
.env.local
*.pem

# Java / Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/
*.class

# Node / Yarn 4 (node-modules linker).
# yarn.lock IS committed; these caches are not. Patterns are unanchored so they
# match at any depth (frontend/.yarn/...), not just the repo root.
node_modules/
**/.yarn/cache/
**/.yarn/install-state.gz
**/.yarn/unplugged/
**/.yarn/build-state.yml
.pnp.*
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Playwright
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/e2e/.auth/

# Editors / OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
*.log
