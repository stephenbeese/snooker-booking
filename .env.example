# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Database (must match docker-compose.yml) ---
POSTGRES_DB=snooker
POSTGRES_USER=snooker
POSTGRES_PASSWORD=snooker
# 5433, not 5432: a host Postgres already owns 5432 on the dev machine.
POSTGRES_PORT=5433

# Consumed by the backend.
DATABASE_URL=jdbc:postgresql://localhost:5433/snooker
DATABASE_USERNAME=snooker
DATABASE_PASSWORD=snooker

# --- Stripe (test mode) — needed from Phase 2 onward, not for Phases 0-1 ---
# Test keys only. A live key (sk_live_...) must never appear in this project.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Printed by: stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- App ---
APP_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
